# Anthropic
ANTHROPIC_API_KEY=

# Auth del agente
MANDI_API_KEY=

# Inbox de IND — fuente de verdad de la conversación (memoria del bot).
# Indi lee el hilo vía GET {INBOX_BASE}/api/conversacion?phone= (ese endpoint ya
# devuelve inbox.mensajes desde Supabase). Por defecto apunta a producción.
INBOX_BASE=https://ind-inbox-v2.vercel.app

# Shopify IND Store
IND_SHOPIFY_SHOP=zjx0hv-av
IND_SHOPIFY_CLIENT_ID=
IND_SHOPIFY_CLIENT_SECRET=

# Google Sheets logging
GOOGLE_SERVICE_ACCOUNT_JSON=

# CRM — botón CREAR PEDIDO (api/crear-pedido.js)
# El CRM es COMPARTIDO con Mandarina y multi-tienda. Por defecto ya apunta al CRM
# de producción con tiendaId=IND (separación total: IDs IND-*, CAPI a INDSTORE).
# Solo define estas variables si algún día IND tiene su PROPIO CRM.
# ⚠️ NUNCA pongas IND_TIENDA_ID=MANDARINA.
IND_CRM_URL=
IND_CRM_BASE=
IND_TIENDA_ID=IND
